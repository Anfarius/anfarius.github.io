---
// simple header component

import Logo from './Logo.astro'
---

<header class="site-header" id="site-header">
    <div class="container">
        <h1 class="logo" id="logo">
            <a href="/"><Logo class="logo" /></a>
            <a href="/">Kacper <span>Kaczmarzyk</span></a>
            <img src="/src/assets/Photo.JPG" alt="headshot" class="photo"/>
        </h1>
        <div class="menu-container" id="menu-container">
            <nav class="menu">
                <a href="#work">About</a>
                <a href="#about">Credits</a>
                <a href="#contact">Resume</a>
            </nav>
            <div class="separator"></div>
        </div>
    </div>
</header>

<script is:client="load">
    const header = document.getElementById("site-header");
    const logo = document.getElementById("logo");
    const scrollHeight = logo.offsetHeight;

    window.addEventListener('scroll', () => {
        const scrollY = window.scrollY;

        if (scrollY > scrollHeight) {
            header.classList.add('scrolled');
        } else if (scrollY < scrollHeight) {
            header.classList.remove('scrolled');
        }
    })
</script>