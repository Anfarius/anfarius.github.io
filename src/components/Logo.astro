---
// Animated Logo

import { Image } from 'astro:assets';
import Caret from '../assets/Logo/Caret_white.png';
import K from '../assets/Logo/<_white.png';

---

<div class="logo-container">
    <Image src={Caret} alt="caret" class="caret" />
    <Image src={K} alt="<" />
</div>

<style>
    .logo-container {

        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0px;
        height: 128px;
        width: 128px;
        padding: 15px;
        background: var(--accent);
        border-radius: 10%;
    }

    .caret {
        animation: blink 1s steps(1) infinite;
    }

    img {
        display: block;
        width: auto;
    }

    @keyframes blink{
        0%, 50% {opacity: 1;}
        51%, 100% {opacity: 0;}
    }
</style>
