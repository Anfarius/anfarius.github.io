---
import { creditData } from "../data/credits-data"
import Layout from "../layouts/Layout.astro"
---

<Layout class="credits">
    <section class="credits-grid">
        {creditData.map((credit) => (
            <a href={credit.storeLink} target="_blank" rel="noopener noreferrer" class="project-card">
                <div class="credit-bg" style={`background-image: url(${credit.image});`}></div>
                <div class="overlay">
                    <h2></h2>
                    <p class="role">{credit.role}</p>
                    <p>{credit.year}</p>
                    <p>{credit.platforms}</p>
                </div>
            </a>
        ))}
    </section>
</Layout>
